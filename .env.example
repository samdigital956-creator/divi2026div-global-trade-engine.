# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 14+. The login role must be able to create roles during migration
# and must bypass RLS for the trusted bootstrap path (Railway's `postgres` user does).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gtc_dev
DATABASE_POOL_MAX=10

# ─── App ─────────────────────────────────────────────────────────────────────
# ≥32 random chars. Signs short-lived local-storage download tokens.
#   openssl rand -base64 48
APP_SECRET=
APP_URL=http://localhost:3000

# ─── Firebase Authentication ─────────────────────────────────────────────────
# Web config (Firebase console → Project settings → Your apps → Web app).
# These are public identifiers by design; served to the browser at runtime.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=

# Admin credentials (SECRET — server only). Either the whole service-account
# JSON (raw or base64) …
FIREBASE_SERVICE_ACCOUNT_JSON=
# … or the three fields separately:
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Local development with the Auth emulator (npm run emulator). Ignored in
# production unless ALLOW_AUTH_EMULATOR=true (only for local prod-build tests).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─── Private document storage ────────────────────────────────────────────────
# local (dev default, files in .data/uploads) | s3 (production default)
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.data/uploads

# S3-compatible bucket (Railway Storage Bucket, AWS S3, R2, MinIO). SECRET.
# S3_ENDPOINT=https://...
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ─── AI / OCR extraction (not implemented in Phase 1) ────────────────────────
# Leave unset: documents go to manual review and the UI says so.
# EXTRACTION_AI_PROVIDER=anthropic|openai
# EXTRACTION_OCR_PROVIDER=google-document-ai|azure-document-intelligence

# ─── Tests ───────────────────────────────────────────────────────────────────
# Must contain "test" in the database name; the suite drops and recreates its schema.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/gtc_test
