{
  "name": "trade-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.mts",
    "emulator": "npx --yes firebase-tools@latest emulators:start --only auth --project demo-gtc",
    "postbuild": "cp -r public .next/standalone/ 2>/dev/null; mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@firebase/app": "^0.16.3",
    "@firebase/auth": "^1.13.6",
    "firebase-admin": "^14.5.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.56.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
